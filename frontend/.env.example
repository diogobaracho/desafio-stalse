# Copy to frontend/.env.local for native runs (`cp frontend/.env.example frontend/.env.local`).

# Base URL the BROWSER uses to call the API. Inlined at build time (NEXT_PUBLIC_*).
#  - native / docker compose: http://localhost:8000
#  - Kubernetes (all envs):   /api   (the ingress routes /api -> backend)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Base URL SERVER components use (read at runtime). Optional locally; required when
# NEXT_PUBLIC_API_BASE_URL is relative (k8s: http://backend:8000, compose: http://backend:8000).
# API_INTERNAL_BASE_URL=http://localhost:8000

# White-label brand file read at runtime (defaults to config/brand.default.json).
# BRAND_CONFIG_PATH=/etc/stalse/brand.json

# Time zone used to display dates (IANA name).
# APP_TIME_ZONE=America/Sao_Paulo
