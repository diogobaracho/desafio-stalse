# Copy to backend/.env for native runs (`cp backend/.env.example backend/.env`).
# Every variable is optional; the values below are the local defaults.

# local | dev | prod - shown by /health and in logs
ENVIRONMENT=local
# SQLite locally; PostgreSQL in Azure, e.g. postgresql+psycopg://user:pass@host:5432/stalse?sslmode=require
DATABASE_URL=sqlite:///./var/stalse.db
# Pre-computed ETL output served by GET /metrics (relative to backend/)
METRICS_FILE_PATH=../data/processed/metrics.json
# n8n webhook - leave empty to disable notifications
N8N_WEBHOOK_URL=http://localhost:5678/webhook/stalse-ticket-updated
N8N_WEBHOOK_TIMEOUT_SECONDS=3
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=text
# true in Azure production: every mutation returns 403
READ_ONLY_MODE=false
# Run migrations + idempotent seed on startup (compose/k8s use an explicit init step instead)
SEED_ON_STARTUP=false
# Route prefix; Kubernetes uses /api so any ingress controller can route without rewrites
API_PREFIX=
